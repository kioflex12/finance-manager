# Токен бота от @BotFather
BOT_TOKEN=
# Юзернейм бота без @ — для ссылок-приглашений
BOT_USERNAME=
# Публичный HTTPS-адрес миниаппа (тот же сервер отдаёт собранный фронт)
WEBAPP_URL=
PORT=3000

# Postgres. Если пусто — встроенная PGlite с файлами в .data/ (удобно локально)
DATABASE_URL=

# LLM для разбора и категоризации: любой сервис с OpenAI-совместимым /chat/completions.
# Пример — бесплатный тариф Mistral (ключ: console.mistral.ai → API Keys); на нём доступны модели ministral-*. Без LLM работает только быстрый разбор «400 продукты».
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=ministral-8b-latest

# Распознавание голоса через OpenAI-совместимый /audio/transcriptions.
# STT_BASE_URL и STT_API_KEY по умолчанию берутся из LLM_* — у Mistral достаточно указать модель.
STT_MODEL=voxtral-mini-latest
STT_BASE_URL=
STT_API_KEY=

# Только для локальной разработки: открыть миниапп в браузере без Telegram от имени этого tg id
DEV_TG_ID=

# --- Только для запуска через docker compose на сервере ---
# Домен, который указывает на сервер; Caddy сам получит для него HTTPS-сертификат.
# WEBAPP_URL и DATABASE_URL в этом режиме выставляются автоматически.
DOMAIN=
POSTGRES_PASSWORD=

# Telegram id администраторов через запятую — им в приложении доступна админка (Журнал → Админка)
ADMIN_TG_IDS=
