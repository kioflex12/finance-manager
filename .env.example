# Токен бота от @BotFather
BOT_TOKEN=
# Юзернейм бота без @ — для ссылок-приглашений
BOT_USERNAME=
# Публичный HTTPS-адрес миниаппа (тот же сервер отдаёт собранный фронт)
WEBAPP_URL=
PORT=3000

# Postgres. Если пусто — встроенная PGlite с файлами в .data/ (удобно локально)
DATABASE_URL=

# LLM для разбора и категоризации. Без ключа работает только быстрый разбор «400 продукты»
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Распознавание голоса: любой сервис с OpenAI-совместимым /audio/transcriptions
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# Только для локальной разработки: открыть миниапп в браузере без Telegram от имени этого tg id
DEV_TG_ID=
